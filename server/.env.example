# Copy this file to .env and fill in values before starting the server.
# Never commit .env to git.

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Server port (Railway sets this automatically)
PORT=3001

# Frontend origin for CORS (your Vercel URL or localhost for dev)
ALLOWED_ORIGIN=http://localhost:8080

# Optional: Plausible analytics domain (leave blank to disable)
PLAUSIBLE_DOMAIN=heyberu.com

# Optional: Web Push keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:hello@heyberu.com
